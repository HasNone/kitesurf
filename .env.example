# Copy to .env (chmod 600). All optional.
# Image to run. Default is a local build: docker build -t kitesurf:local .
KITESURF_IMAGE=kitesurf:local
# Host address/port the engine is published on. Keep loopback.
KITESURF_BIND=127.0.0.1
KITESURF_PORT=8787
# Host names clients may use in the URL (any port), comma-separated.
# Empty = 127.0.0.1,localhost,[::1]. Requests with any other Host header are
# rejected, which stops DNS-rebinding attacks. "*" disables the check.
KITESURF_ALLOWED_HOSTS=
# Optional shared secret. When set, clients must send it as
# "Authorization: Bearer <token>", an "X-Kitesurf-Token" header, or ?token=.
# /health stays open for health checks.
KITESURF_AUTH_TOKEN=
# Container limits (many parallel navigations can use several GB).
KITESURF_MEM_LIMIT=4g
KITESURF_PIDS_LIMIT=512
# Engine tuning (empty = upstream default).
KITESURF_PAGE_CPU_MS_CAP=
KITESURF_PAGE_WALL_MS_CAP=
KITESURF_DISABLE_PARTIAL_RASTER=
KITESURF_RESOURCE_DRAIN_QUIET_TURNS=
# OTLP trace endpoint; traces include page text and request URLs.
KITESURF_OTLP_ENDPOINT=
# Set to 1 to let pages reach loopback/private addresses (off by default).
KITESURF_ALLOW_PRIVATE_NETWORK=
